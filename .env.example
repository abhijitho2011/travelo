# App
NODE_ENV=development
PORT=3000
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
API_PREFIX=/api/v1/admin
LOG_LEVEL=info
# Comma-separated list of allowed origins for CORS (no defaults; must be set explicitly)
CORS_ORIGINS=https://admin.travelo.io

# Database (PostgreSQL) — Railway-style private-network reference
DATABASE_URL=postgres://postgres:${{POSTGRES_PASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/railway
DATABASE_SSL=false

# Redis — Railway-style private-network reference
REDIS_URL=redis://default:${{REDIS_PASSWORD}}@${{Redis.RAILWAY_PRIVATE_DOMAIN}}:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-please
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Rate limiting (per minute per IP)
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Seed defaults
SEED_SUPER_ADMIN_EMAIL=admin@travelo.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe!12345
