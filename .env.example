# App
NODE_ENV=development
PORT=3000
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
API_PREFIX=/api/v1/admin
LOG_LEVEL=info
# Comma-separated list of allowed origins for CORS (no defaults; must be set explicitly)
CORS_ORIGINS=https://admin.tavelo.io

# Database (PostgreSQL) — Railway-style private-network reference
DATABASE_URL=postgres://postgres:${{POSTGRES_PASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/railway
DATABASE_SSL=false

# Redis — Railway-style private-network reference
REDIS_URL=redis://default:${{REDIS_PASSWORD}}@${{Redis.RAILWAY_PRIVATE_DOMAIN}}:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-please
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Rate limiting (per minute per IP)
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Seed defaults
SEED_SUPER_ADMIN_EMAIL=admin@tavelo.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe!12345

# ---------- Owner auth (separate secrets from admin) ----------
OWNER_JWT_ACCESS_SECRET=change-me-owner-access-secret-min-32-chars
OWNER_JWT_REFRESH_SECRET=change-me-owner-refresh-secret-min-32-chars
OWNER_JWT_ACCESS_TTL=15m
OWNER_JWT_REFRESH_TTL=30d

# ---------- Staff auth (third token family — separate from admin AND owner) ----------
STAFF_JWT_ACCESS_SECRET=change-me-staff-access-secret-min-32-chars
STAFF_JWT_REFRESH_SECRET=change-me-staff-refresh-secret-min-32-chars
STAFF_JWT_ACCESS_TTL=15m
STAFF_JWT_REFRESH_TTL=30d

# ---------- Firebase (Google sign-in for owners) ----------
FIREBASE_PROJECT_ID=tavelo-c4669
# Optional: full service-account JSON string (leave empty to verify ID tokens via Google public certs)
FIREBASE_SERVICE_ACCOUNT=
# Optional: path to a service-account file
GOOGLE_APPLICATION_CREDENTIALS=

# ---------- OTP ----------
OTP_TTL_MIN=10
OTP_MAX_ATTEMPTS=5

# ---------- SMS provider (console | bsnl) ----------
SMS_PROVIDER=console
# BSNL DLT — set these (as Railway service variables, never commit) when SMS_PROVIDER=bsnl
BSNL_BASE_URL=
BSNL_USERNAME=
BSNL_PASSWORD=
BSNL_HEADER=
BSNL_ENTITY_ID=
BSNL_TEMPLATE_ID=
BSNL_SERVICE_ID=
BSNL_TOKEN_ID=
BSNL_TEMPLATE_VAR_KEY=motcode
BSNL_TOKEN_PATH=/api/Create_New_API_Token
BSNL_SEND_PATH=/api/Send_SMS
BSNL_INSECURE_TLS=false

# ---------- Object storage (property photos, invoice documents) ----------
# local = mounted volume at UPLOADS_DIR; s3 = Railway bucket.
# The S3 values are supplied as Railway reference variables — never commit them.
STORAGE_DRIVER=local
UPLOADS_DIR=/app/uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- Payment gateways (subscription order creation + refunds) ----------
# Optional. With neither pair set, the gateway endpoints return a typed
# GATEWAY_NOT_CONFIGURED and the manual-payment path still collects money.
# Refunds route to the matching gateway; an unconfigured gateway degrades a
# refund to MANUAL. Webhooks are settled only when the captured amount matches
# the order amount, and are signature-verified when the secret below is set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET_RAZORPAY=
# Cashfree: BOTH halves required to enable it. CASHFREE_ENV selects sandbox
# (default) vs production; API version is a dated header Cashfree pins to.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01
PAYMENT_WEBHOOK_SECRET_CASHFREE=

# ---------- Security & rate limiting (Phase 7) ----------
# Broad per-IP ceiling (default 120 req / 60s) and a tighter tier the auth
# endpoints (login/OTP/MFA) opt into (default 10 req / 60s).
THROTTLE_TTL=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=10

# TOTP MFA (admin + owner + staff). 32 random bytes, base64. Without it MFA
# enrolment is refused (never degraded); MFA is opt-in per user.
MFA_SECRET_KEY=

# Channex webhook shared secret. REQUIRED in production when CHANNEX_ENABLED=true
# — the webhook endpoint refuses unverified events otherwise.
CHANNEX_WEBHOOK_SECRET=

# ---------- Data retention (Phase 7) ----------
# The daily retention worker prunes rows older than these (days). 0 disables.
AUDIT_RETENTION_DAYS=365
DELIVERY_RETENTION_DAYS=90

# ---------- Observability (Phase 8) ----------
# Optional. Set a DSN and add @sentry/node to enable Sentry; unset leaves
# correlation-ID structured logging as the error trail. Prometheus metrics are
# always exposed at GET /metrics (no config needed).
SENTRY_DSN=
